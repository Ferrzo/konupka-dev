---
const year = "© " + new Date().getFullYear();
---

<footer>
  <ul>
    <li class="link_btn">
      <a
        class="icon-button"
        aria-label="Visit my GitHub profile"
        href="https://github.com/ferrzo"
        target="_blank"
        rel="noopener noreferrer"><span class="github-icon">Github</span></a
      >
    </li>
    <li class="link_btn">
      <a
        class="icon-button"
        aria-label="Send me an Email"
        href="mailto:jaromir@konupka.dev"
        ><span class="email-icon">Email</span></a
      >
    </li>
    <li class="link_btn">
      <a
        class="icon-button"
        aria-label="Connect with me on LinkedIn"
        href="https://www.linkedin.com/in/jaromirkonupka/"
        target="_blank"
        rel="noopener noreferrer"><span class="linkedin-icon">LinkedIn</span></a
      >
    </li>
  </ul>
  <small class="center">{year}</small>
</footer>

<style>
  ul {
    list-style-type: none;
    text-align: center;
    padding: 0;
  }

  li {
    margin: 0 1rem;
    display: inline-block;
  }

  footer {
    display: flex;
    flex-direction: column;
  }

  small {
    margin-top: 1rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    ul {
      flex-direction: column;
      align-items: center;
    }

    li {
      margin: 1rem;
    }
  }
</style>
