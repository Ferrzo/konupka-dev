---
import ThemeIcon from "./ThemeIcon.astro";
import Navigation from "./Navigation.astro";
---

<header>
  <h1 class="title">
    <a href="/" class="rock-salt-regular">Konupka</a>
  </h1>
  <div class="navigation">
    <Navigation />
    <ThemeIcon />
  </div>
</header>

<style>
  .title a {
    text-decoration: none;
  }
  
  .rock-salt-regular {
    font-family: "Rock Salt", "Brush Script MT", cursive, system-ui;
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  .navigation {
    display: flex;
    align-items: center;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
  }
  @media (max-width: 768px) {
    header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
