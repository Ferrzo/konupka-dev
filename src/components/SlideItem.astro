---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  logoId: string;
  altText: string;
  url: string;
}

const { logoId, altText, url } = Astro.props;
const imagePath = `/src/assets/images/logos/${logoId}`;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/logos/*.{jpeg,jpg,png,svg}"
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "/src/assets/images/logos/*.{jpeg,jpg,png,svg}"`
  );

const imageImport = await images[imagePath]();
const image = imageImport.default;

const imageUrl = image.src; 
const projectName = altText.replace(/ logo/i, "");

const ldjson = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": projectName,
  "url": url,
  "image": imageUrl
};
---

<div class="slide">
  <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${projectName} project`}>
    <Image
      src={image}
      alt={altText}
      decoding="async"
      loading="eager"
      height="100"
      width="256"
    />
  </a>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ldjson)}>
  </script>
</div>

<style>
  .slide {
    margin: 0 15px;
  }
</style>
