---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <title>Jaromir Konupka | Frontend Developer</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rock+Salt&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Rock+Salt&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <meta charset="utf-8" />
    <meta
      name="description"
      content="Jaromír Konůpka is a freelance frontend developer building responsive web and mobile apps with Angular and modern web technologies."
    />
    <meta
      name="keywords"
      content="web developer, portfolio, blog, web development, web design, front-end developer, angular developer"
    />
    <meta name="author" content="Jaromír Konůpka" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="{Astro.generator}" />

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jaromír Konůpka | Frontend Developer" />
    <meta
      property="og:description"
      content="Freelance Angular developer creating modern responsive web and mobile apps."
    />
    <meta property="og:url" content="https://konupka.dev/" />
    <meta property="og:image" content="https://konupka.dev/imageofme.jpeg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jaromír Konůpka | Frontend Developer" />
    <meta
      name="twitter:description"
      content="Freelance Angular developer creating modern responsive web and mobile apps."
    />
    <meta name="twitter:image" content="https://konupka.dev/imageofme.jpeg" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        "name": "Jaromir Konupka",
        "url": "https://konupka.dev"
      }
    </script>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jaromír Konůpka",
        "url": "https://konupka.dev/",
        "image": "https://konupka.dev/imageofme.jpeg",
        "jobTitle": "Frontend Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Actum Digital",
          "url": "https://www.actumdigital.com/"
        },
        "sameAs": [
          "https://www.facebook.com/jaromirkonupka/",
          "https://www.linkedin.com/in/jaromirkonupka/",
          "https://www.github.com/ferrzo"
        ],
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://konupka.dev/"
        }
      }
    </script>
  </head>
  <body>
    <Header />
    <div class="container">
      <slot />
    </div>
    <Footer />
  </body>
</html>
