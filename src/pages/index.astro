---
import BaseLayout from "../layouts/BaseLayout.astro";
import Article from "../components/Article.astro";
import { Image } from "astro:assets";
import hikeImage from "/src/assets/images/hike_image.svg";
import Slide from "../components/Slide.astro";
---

<BaseLayout>
  <div class="hero-section">
    <div class="profile-container">
      <Image
        src={hikeImage}
        alt="hiking person"
        decoding="async"
        loading="eager"
        width="256"
        height="256"
        class="profile-image"
        fetchpriority="high"
      />
    </div>
  </div>

  <Article id="about" title="Jaromir Konupka" mainTitle={true}>
    <p class="intro-text">
      Hello! I'm a <strong>frontend developer</strong> specializing in Angular. I thrive
      on bringing innovative ideas to life on the web. Over the past few years,
      I’ve improved my skills in Angular, becoming proficient in building dynamic, responsive web apps and mobile applications.
    </p>

    <p>Feel free to contact me.</p>
  </Article>
  <Article id="skills" title="Skills">
    <div class="skills-grid">
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of angular"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angular/angular-original.svg"
        />
        <span class="skill-name">Angular</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of typescript"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg"
        />
        <span class="skill-name">TypeScript</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of css"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg"
        />
        <span class="skill-name">CSS3</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of html"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg"
        />
        <span class="skill-name">HTML5</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of ngrx"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/ngrx/ngrx-original.svg"
        />
        <span class="skill-name">NgRx</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of ionic"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/ionic/ionic-original.svg"
        />
        <span class="skill-name">Ionic</span>
      </div>
      <div class="skill-item">
        <Image
          width={60}
          height={60}
          class="skill-icon"
          alt="logo of git"
          loading="eager"
          decoding="async"
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg"
        />
        <span class="skill-name">Git</span>
      </div>
    </div>
  </Article>
  <Article id="portfolio" title="Portfolio">
    <Slide />
    <Article id="blogs" title="Interests">
      <p>
        When I’m not coding or hiking, you’ll find me diving into new
        technologies, exploring gravel cycling trails, playing video games,
        board games, or enjoying a good book. My goal is to continue growing as
        a developer and to contribute to projects that make a positive impact.
      </p>
    </Article>
  </Article>

  <style>
    .hero-section {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 3rem 0 2rem;
      animation: fadeIn 0.8s ease-out;
    }

    .profile-container {
      position: relative;
    }

    .profile-image {
      object-fit: cover;
      border-radius: 50%;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      border: 4px solid rgba(255, 255, 255, 0.8);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: float 3s ease-in-out infinite;
    }

    .profile-image:hover {
      transform: scale(1.05);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
    }

    .intro-text {
      font-size: 1.15rem;
      line-height: 1.9;
    }

    .intro-text strong {
      color: var(--primary-color);
      font-weight: 700;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 2rem;
      padding: 1rem;
    }

    .skill-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 16px;
      border: 1px solid var(--border-color);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .skill-item:hover {
      transform: translateY(-8px) scale(1.05);
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }

    .skill-icon {
      height: 4rem;
      width: 4rem;
      transition: transform 0.3s ease;
    }

    .skill-item:hover .skill-icon {
      transform: rotateY(360deg);
    }

    .skill-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color);
      text-align: center;
    }

    @media (max-width: 768px) {
      .skills-grid {
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 1.5rem;
      }

      .skill-item {
        padding: 1rem;
      }
    }

    :global(.dark) .skill-item {
      background: rgba(30, 41, 59, 0.5);
    }

    :global(.dark) .skill-item:hover {
      background: rgba(30, 41, 59, 0.8);
    }

    :global(.dark) .skill-name {
      color: var(--color-dark);
    }

    :global(.dark) .intro-text strong {
      color: var(--primary-light);
    }

    :global(.dark) .profile-image {
      border-color: rgba(30, 41, 59, 0.8);
    }
  </style>
</BaseLayout>
