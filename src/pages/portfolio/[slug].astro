---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/logos/*.{jpeg,jpg,png,svg,webp}'
);
const imagePath = `/src/assets/images/logos/${project.data.logoId}`;
const logoModule = await logos[imagePath]();
const logo = logoModule.default;
---

<BaseLayout
  title={`${project.data.title} — ${project.data.company} | Jaromir Konupka`}
  description={project.data.excerpt}
>
  <div class="back-link-wrap">
    <a href="/portfolio/" class="back-link">← Back to Portfolio</a>
  </div>

  <div class="project-header">
    <div class={`project-logo${project.data.logoNeedsBackground ? ' logo-contrast-bg' : ''}`}>
      <Image
        src={logo}
        alt={`${project.data.company} logo`}
        width={1024}
        height={90}
        decoding="async"
        loading="eager"
      />
    </div>

    <div class="project-meta">
      <h1 class="project-title">{project.data.title}</h1>

      <dl class="meta-grid">
        <dt>Company</dt>
        <dd>{project.data.company}</dd>

        <dt>Role</dt>
        <dd>{project.data.role}</dd>

        <dt>Period</dt>
        <dd>{project.data.year}</dd>

        {project.data.url && (
          <>
            <dt>Website</dt>
            <dd>
              <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="external-link">
                {project.data.url.replace(/^https?:\/\//, '')} ↗
              </a>
            </dd>
          </>
        )}
      </dl>

      <div class="tech-stack">
        <p class="tech-label">Tech stack</p>
        <div class="tags">
          {project.data.technologies.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="project-content prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .back-link-wrap {
    padding: 1.5rem 0 0;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.75;
  }

  .project-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: start;
    background: var(--surface-color);
    border-radius: 24px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    padding: 2.5rem;
    margin: 1.5rem 0;
    animation: fadeIn 0.6s ease-out;
  }

  .project-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    border: 1px solid var(--border-color);
    align-self: center;
  }

  .logo-contrast-bg {
    background: #1e293b;
    border-color: transparent;
  }

  :global(.dark) .logo-contrast-bg {
    background: rgba(255, 255, 255, 0.85);
    border-color: transparent;
  }

  .project-logo img {
    max-width: 200px;
    max-height: 90px;
    object-fit: contain;
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-title {
    margin: 0;
    font-size: 2rem;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.5rem;
    margin: 0;
  }

  .meta-grid dt {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    padding-top: 2px;
  }

  .meta-grid dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color);
  }

  .external-link {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 600;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .tech-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    margin: 0 0 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-color);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  /* Prose styles for rendered markdown */
  .project-content {
    background: var(--surface-color);
    border-radius: 24px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    padding: 2.5rem;
    margin-bottom: 3rem;
    line-height: 1.8;
    animation: fadeIn 0.7s ease-out;
  }

  .project-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
    color: var(--color);
  }

  .project-content :global(h2::after) {
    width: 40%;
  }

  .project-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
    color: var(--color);
  }

  .project-content :global(p) {
    margin: 0 0 1rem;
    color: var(--color);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .project-content :global(strong) {
    color: var(--primary-color);
    font-weight: 700;
  }

  .project-content :global(a) {
    color: var(--primary-color);
    font-weight: 600;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .project-header {
      grid-template-columns: 1fr;
    }

    .project-logo {
      justify-self: start;
    }
  }

  :global(.dark) .project-header,
  :global(.dark) .project-content {
    background: var(--surface-color-dark);
    border-color: var(--border-color-dark);
  }

  :global(.dark) .project-logo {
    background: rgba(30, 41, 59, 0.7);
  }

  :global(.dark) .meta-grid dd,
  :global(.dark) .project-content :global(p),
  :global(.dark) .project-content :global(li) {
    color: var(--color-dark);
  }

  :global(.dark) .project-content :global(h2),
  :global(.dark) .project-content :global(h3) {
    color: var(--color-dark);
  }

  :global(.dark) .meta-grid dt,
  :global(.dark) .tech-label {
    color: var(--color-secondary-dark);
  }
</style>
