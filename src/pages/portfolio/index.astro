---
export const prerender = true;
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allProjects = await getCollection('portfolio');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const logos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/logos/*.{jpeg,jpg,png,svg}'
);

const projectsWithLogos = await Promise.all(
  projects.map(async (project) => {
    const imagePath = `/src/assets/images/logos/${project.data.logoId}`;
    const logoModule = await logos[imagePath]();
    return { ...project, logo: logoModule.default };
  })
);
---

<BaseLayout
  title="Portfolio | Jaromir Konupka"
  description="Projects and clients I've worked with as a frontend developer — Angular, Ionic, TypeScript and more."
>
  <div class="page-header">
    <h1>Portfolio</h1>
    <p class="subtitle">Projects I've had the pleasure to work on.</p>
  </div>

  <div class="projects-grid">
    {projectsWithLogos.map((project) => (
      <a href={`/portfolio/${project.id}/`} class="project-card">
        <div class="card-logo">
          <Image
            src={project.logo}
            alt={`${project.data.company} logo`}
            width={200}
            height={80}
            decoding="async"
            loading="lazy"
          />
        </div>
        <div class="card-body">
          <h2 class="card-title">{project.data.title}</h2>
          <p class="card-company">{project.data.company} &middot; {project.data.year}</p>
          <p class="card-excerpt">{project.data.excerpt}</p>
          <div class="card-tags">
            {project.data.technologies.slice(0, 4).map((tech) => (
              <span class="tag">{tech}</span>
            ))}
            {project.data.technologies.length > 4 && (
              <span class="tag tag-more">+{project.data.technologies.length - 4}</span>
            )}
          </div>
          <span class="card-link">Read more →</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 0 1rem;
    animation: fadeIn 0.6s ease-out;
  }

  .page-header h1 {
    margin: 0 0 0.5rem;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--color-secondary);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    padding: 1rem 0 3rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-color);
    border-radius: 20px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-color);
  }

  .card-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.6);
    border-bottom: 1px solid var(--border-color);
    min-height: 120px;
  }

  .card-logo img {
    max-height: 80px;
    width: auto;
    object-fit: contain;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    flex: 1;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color);
  }

  /* override h2 global underline */
  .card-title::after {
    display: none;
  }

  .card-company {
    font-size: 0.9rem;
    color: var(--primary-color);
    font-weight: 600;
    margin: 0;
  }

  .card-excerpt {
    font-size: 0.95rem;
    color: var(--color-secondary);
    line-height: 1.6;
    margin: 0.25rem 0;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-color);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .tag-more {
    background: transparent;
    color: var(--color-secondary);
    border-color: var(--border-color);
  }

  .card-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary-color);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  :global(.dark) .card-logo {
    background: rgba(30, 41, 59, 0.6);
  }

  :global(.dark) .project-card {
    background: var(--surface-color-dark);
    border-color: var(--border-color-dark);
  }

  :global(.dark) .card-title {
    color: var(--color-dark);
  }

  :global(.dark) .card-excerpt {
    color: var(--color-secondary-dark);
  }

  :global(.dark) .subtitle {
    color: var(--color-secondary-dark);
  }
</style>
